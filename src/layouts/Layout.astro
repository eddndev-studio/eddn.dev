---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	hreflangs?: Array<{ lang: string; href: string }>;
	prevUrl?: string;
	nextUrl?: string;
}

const {
	title = "eddn.dev — Personal Journal",
	description,
	hreflangs = [],
	prevUrl,
	nextUrl,
} = Astro.props;

const lang = Astro.currentLocale || 'en';

// Locale-aware SEO defaults (else EN pages inherit a Spanish description).
const metaDescription = description ?? (lang === 'es'
	? "Ingeniería de software, trayectoria y pensamientos personales de Eduardo Alonso."
	: "Software engineering, trajectory, and personal notes by Eduardo Alonso.");
const imageAltPrefix = lang === 'es' ? 'Portada de:' : 'Cover of:';
---

<!doctype html>
<html lang={lang} class="overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<script is:inline>
			(function() {
				var t = localStorage.getItem('theme');
				if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme:dark)').matches)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={metaDescription} />

		<!-- Canonical URL -->
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Hreflang Tags -->
		{
			hreflangs.map(({ lang, href }) => (
				<link
					rel="alternate"
					hreflang={lang}
					href={new URL(href, Astro.site)}
				/>
			))
		}

		<!-- RSS Feeds -->
		<link rel="alternate" type="application/rss+xml" title="eddn.dev (EN)" href={new URL('/rss.xml', Astro.site)} />
		<link rel="alternate" type="application/rss+xml" title="eddn.dev (ES)" href={new URL('/es/rss.xml', Astro.site)} />

		<!-- Pagination SEO -->
		{prevUrl && <link rel="prev" href={new URL(prevUrl, Astro.site)} />}
		{nextUrl && <link rel="next" href={new URL(nextUrl, Astro.site)} />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:site_name" content="eddn.dev" />
		
		<!-- Open Graph Image Generation -->
		<meta property="og:image" content={`https://og.eddn.dev/generate?title=${encodeURIComponent(title)}${Astro.url.pathname.includes('/blog/') ? '&og_type=Article' : Astro.url.pathname.includes('/leetcode/') ? '&og_type=Solution' : Astro.url.pathname.includes('/articles/') ? '&og_type=Paper' : '&og_type=Page'}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={`${imageAltPrefix} ${title}`} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={metaDescription} />
		<meta property="twitter:image" content={`https://og.eddn.dev/generate?title=${encodeURIComponent(title)}${Astro.url.pathname.includes('/blog/') ? '&og_type=Article' : Astro.url.pathname.includes('/leetcode/') ? '&og_type=Solution' : Astro.url.pathname.includes('/articles/') ? '&og_type=Paper' : '&og_type=Page'}`} />
		<meta property="twitter:image:alt" content={`${imageAltPrefix} ${title}`} />

		<ClientRouter />

		<!-- Fonts (self-hosted, preloaded) -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/dm-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

		<!-- KaTeX for math rendering -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
			crossorigin="anonymous"
		/>
	</head>
	<body class="selection:bg-brand-500/30 overflow-x-hidden relative">
		<Header />
		<Search />
		<main class="pt-16" data-pagefind-filter={`lang:${lang}`}>
			<slot />
		</main>
		<Footer />

		<script>
			function applyStagger(elements: NodeListOf<Element>, cls: string, staggerMs: number, baseMs = 0) {
				elements.forEach((el, i) => {
					(el as HTMLElement).style.setProperty('--delay', `${baseMs + i * staggerMs}ms`);
					el.classList.add(cls);
					el.addEventListener('animationend', () => {
						el.classList.remove(cls);
						(el as HTMLElement).style.removeProperty('--delay');
					}, { once: true });
				});
			}

			function animateContent() {
				// Honor reduced-motion: skip the staggered entrance entirely
				// (elements have no hidden base state, so they just appear).
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

				// 1. Page header reveal (index/trajectory pages tag their
				//    header with [data-page-header]; nesting-independent so
				//    pages keep a single <main> landmark from Layout).
				const heroElements = document.querySelectorAll("[data-page-header] > *");
				if (heroElements.length) {
					applyStagger(heroElements, 'anim-fade-up', 100);
				}

				// 2. Grid Items (Blog Posts, Cards)
				const gridItems = document.querySelectorAll(".grid > article, .grid > a, .grid > div");
				if (gridItems.length) {
					applyStagger(gridItems, 'anim-fade-up-sm', 50, 100);
				}

				// 3. List/Table Items (LeetCode Rows, Trajectory Timeline)
				const listItems = document.querySelectorAll("tbody > tr, .space-y-12 > .relative");
				if (listItems.length) {
					applyStagger(listItems, 'anim-slide-left', 50, 300);
				}
			}

			function init() {
				animateContent();
			}

			// Restore dark class after Astro view-transition DOM swap
			document.addEventListener("astro:after-swap", () => {
				const t = localStorage.getItem('theme');
				const prefersDark = matchMedia('(prefers-color-scheme:dark)').matches;
				if (t === 'dark' || (!t && prefersDark)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			});

			document.addEventListener("astro:page-load", init);
		</script>

		<style is:global>
			@keyframes fade-up {
				from { opacity: 0; transform: translateY(20px); }
			}
			@keyframes fade-up-sm {
				from { transform: translateY(10px); }
			}
			@keyframes slide-left {
				from { opacity: 0; transform: translateX(-10px); }
			}
			.anim-fade-up {
				animation: fade-up 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) var(--delay, 0ms) both;
			}
			.anim-fade-up-sm {
				animation: fade-up-sm 0.4s ease-out var(--delay, 0ms) both;
			}
			.anim-slide-left {
				animation: slide-left 0.5s ease-out var(--delay, 0ms) both;
			}
		</style>
	</body>
</html>
