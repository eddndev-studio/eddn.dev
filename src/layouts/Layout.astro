---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	hreflangs?: Array<{ lang: string; href: string }>;
	prevUrl?: string;
	nextUrl?: string;
}

const {
	title = "eddn.dev - Eduardo Alonso",
	description,
	hreflangs = [],
	prevUrl,
	nextUrl,
} = Astro.props;

const lang = Astro.currentLocale || 'en';

// Locale-aware SEO defaults (else EN pages inherit a Spanish description).
const metaDescription = description ?? (lang === 'es'
	? "Compiladores, sistemas backend y notas técnicas de Eduardo Alonso."
	: "Compilers, backend systems and technical notes by Eduardo Alonso.");
const imageAltPrefix = lang === 'es' ? 'Portada de:' : 'Cover of:';
---

<!doctype html>
<html lang={lang} class="dark overflow-x-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={metaDescription} />

		<!-- Canonical URL -->
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Hreflang Tags -->
		{
			hreflangs.map(({ lang, href }) => (
				<link
					rel="alternate"
					hreflang={lang}
					href={new URL(href, Astro.site)}
				/>
			))
		}

		<!-- RSS Feeds -->
		<link rel="alternate" type="application/rss+xml" title="eddn.dev (EN)" href={new URL('/rss.xml', Astro.site)} />
		<link rel="alternate" type="application/rss+xml" title="eddn.dev (ES)" href={new URL('/es/rss.xml', Astro.site)} />

		<!-- Pagination SEO -->
		{prevUrl && <link rel="prev" href={new URL(prevUrl, Astro.site)} />}
		{nextUrl && <link rel="next" href={new URL(nextUrl, Astro.site)} />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:site_name" content="eddn.dev" />
		
		<!-- Open Graph Image Generation -->
		<meta property="og:image" content={`https://og.eddn.dev/generate?title=${encodeURIComponent(title)}${Astro.url.pathname.includes('/blog/') ? '&og_type=Article' : Astro.url.pathname.includes('/leetcode/') ? '&og_type=Solution' : Astro.url.pathname.includes('/articles/') ? '&og_type=Article' : '&og_type=Page'}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={`${imageAltPrefix} ${title}`} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={metaDescription} />
		<meta property="twitter:image" content={`https://og.eddn.dev/generate?title=${encodeURIComponent(title)}${Astro.url.pathname.includes('/blog/') ? '&og_type=Article' : Astro.url.pathname.includes('/leetcode/') ? '&og_type=Solution' : Astro.url.pathname.includes('/articles/') ? '&og_type=Article' : '&og_type=Page'}`} />
		<meta property="twitter:image:alt" content={`${imageAltPrefix} ${title}`} />

		<ClientRouter />

		<!-- Display font is bundled by Vite; preload the canvas font. -->
		<link rel="preload" href="/fonts/dm-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

		<!-- KaTeX for math rendering -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
			crossorigin="anonymous"
		/>
	</head>
	<body class="selection:bg-brand-500/30 overflow-x-hidden relative">
		<Header />
		<Search />
		<main class="pt-20" data-pagefind-filter={`lang:${lang}`}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
