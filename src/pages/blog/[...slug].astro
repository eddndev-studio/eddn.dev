---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ViewCounter from "../../components/ViewCounter.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const englishPosts = posts.filter((p) => p.id.startsWith("en/"));
	return englishPosts.map((post) => {
		const slug = post.id.replace(/^en\//, "").replace(/\.(md|mdx)$/, "");
		return {
			params: { slug },
			props: post,
		};
	});
}

const post = Astro.props;
const { Content } = await render(post);

// Find translation
const allPosts = await getCollection("blog");
const translationKey = post.data.translationKey;
let hreflangs = [
	{
		lang: "en",
		href: `/blog/${post.id.replace(/^en\//, "").replace(/\.(md|mdx)$/, "")}/`,
	},
];

if (translationKey) {
	const spanishPost = allPosts.find(
		(p) =>
			p.id.startsWith("es/") && p.data.translationKey === translationKey,
	);
	if (spanishPost) {
		const esSlug = spanishPost.id
			.replace(/^es\//, "")
			.replace(/\.(md|mdx)$/, "");
		hreflangs.push({ lang: "es", href: `/es/blog/${esSlug}/` });
	}
}
---

<Layout
	title={`${post.data.title} — eddn.dev`}
	description={post.data.description}
	hreflangs={hreflangs}
>
	<div class="max-w-7xl mx-auto px-6 py-24 lg:py-32" data-pagefind-body data-pagefind-filter="type:Blog">
		<header class="mb-16 lg:mb-24 max-w-4xl">
			<div class="flex items-center gap-4 mb-6">
				<time
					transition:name={`date-${post.id}`}
					class="text-sm font-mono text-mute uppercase tracking-widest"
				>
					{
						post.data.pubDate.toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})
					}
				</time>
				<div class="h-1 w-1 rounded-full bg-hairline"></div>
				<ViewCounter slug={`blog-${post.id.replace('/', '-')}`} />
				{
					post.data.updatedDate && (
						<span class="text-xs text-mute font-mono">
							(Updated)
						</span>
					)
				}
			</div>

			<h1
				transition:name={`title-${post.id}`}
				class="text-5xl sm:text-7xl font-normal tracking-[-0.03em] text-ink leading-[0.95] mb-8"
			>
				{post.data.title}
			</h1>

			{
				post.data.tags && (
					<div class="flex flex-wrap gap-x-4 gap-y-2">
						{post.data.tags.map((tag) => (
							<span class="text-sm font-mono text-mute hover:text-ink transition-colors cursor-default">
								#{tag}
							</span>
						))}
					</div>
				)
			}
		</header>

		<div
			id="main-content-grid"
			class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24"
		>
			<!-- Sidebar / Metadata -->
			<aside
				id="sidebar-container"
				class="hidden lg:block lg:col-span-3 relative"
			>
				<div id="sidebar-inner" class="space-y-8">
					<div
						class="text-sm text-body leading-relaxed border-l border-hairline pl-4"
					>
						<p>{post.data.description}</p>
					</div>
					<div class="h-px bg-hairline w-12"></div>
					<a
						href="/blog/"
						class="inline-flex items-center text-sm font-medium text-body hover:text-ink transition-colors group rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
					>
						<svg
							class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
						>
						Back to Blog
					</a>
				</div>
			</aside>

			<!-- Main Content -->
			<article class="lg:col-span-8 lg:col-start-5">
				<div
					class="prose prose-lg max-w-none
					prose-headings:font-medium prose-headings:tracking-tight
					prose-a:font-medium prose-a:underline prose-a:underline-offset-2 prose-a:decoration-mute hover:prose-a:decoration-ink
					prose-pre:rounded-md
					prose-img:rounded-md"
				>
					<Content />
				</div>

				<div
					class="mt-24 pt-12 border-t border-hairline flex justify-between items-center lg:hidden"
				>
					<a
						href="/blog/"
						class="inline-flex items-center text-sm font-medium text-body hover:text-ink transition-colors group rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
					>
						<svg
							class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
						>
						Back to Blog
					</a>
				</div>
			</article>
		</div>
	</div>
</Layout>

<script>
	import "../../utils/codeUtils";
	import { initStickySidebar } from "../../utils/stickySidebar";

	let cleanup: (() => void) | undefined;

	function setupSticky() {
		cleanup = initStickySidebar(
			"#sidebar-inner",
			"#main-content-grid",
			128,
		);
	}

	function teardownSticky() {
		if (cleanup) cleanup();
	}

	document.addEventListener("astro:page-load", setupSticky);
	document.addEventListener("astro:before-swap", teardownSticky);
</script>
