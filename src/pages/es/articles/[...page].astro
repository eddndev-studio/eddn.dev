---
import Layout from "../../../layouts/Layout.astro";
import Pagination from "../../../components/Pagination.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection("articles"))
		.filter((post) => post.id.startsWith("es/"))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"articles">>;
}

const { page } = Astro.props;

function getSlug(id: string) {
	return id.replace(/^es\//, "").replace(/\.(md|mdx)$/, "");
}
---

<Layout
	title="Artículos — eddn.dev"
	prevUrl={page.url.prev}
	nextUrl={page.url.next}
	hreflangs={[{ lang: "en", href: "/articles/" }]}
>
	<div class="max-w-7xl mx-auto px-6 py-24">
		<header data-page-header class="mb-16">
			<h1
				class="text-6xl sm:text-8xl font-normal tracking-[-0.04em] text-ink leading-[0.9] mb-8"
			>
				PAPERS <br />
				<em class="font-serif italic font-normal lowercase tracking-normal"
					>técnicos.</em
				>
			</h1>
			<p class="text-xl text-body font-normal max-w-2xl leading-snug">
				Artículos técnicos en profundidad, decisiones de arquitectura y
				análisis de sistemas.
			</p>
		</header>

		<div
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-hairline border border-hairline rounded-md overflow-hidden"
		>
			{
				page.data.map((post) => (
					<article class="group relative flex flex-col justify-between gap-8 p-8 bg-canvas hover:bg-ink transition-colors duration-300 overflow-hidden select-none">
						<div>
							<time
								transition:name={`date-${post.id}`}
								class="relative z-10 mb-4 block text-xs font-mono text-mute group-hover:text-canvas/60 uppercase tracking-widest transition-colors pointer-events-none"
							>
								{post.data.pubDate.toLocaleDateString("es-ES", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</time>

							<h2
								transition:name={`title-${post.id}`}
								class="text-2xl font-normal tracking-tight text-ink group-hover:text-canvas mb-4 transition-colors leading-tight"
							>
								<a
									href={`/es/articles/${getSlug(post.id)}`}
									class="rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
								>
									<span class="absolute inset-0 z-20" />
									{post.data.title}
								</a>
							</h2>

							<p class="relative z-10 text-body group-hover:text-canvas/80 leading-relaxed line-clamp-3 transition-colors pointer-events-none">
								{post.data.abstract || post.data.description}
							</p>

							<div class="flex gap-2 mt-6 pointer-events-none">
								<span class="relative z-10 text-[11px] font-mono px-2 py-0.5 rounded-[3px] border border-hairline text-mute group-hover:border-canvas/30 group-hover:text-canvas/80 transition-colors">
									{post.data.technicalDepth}
								</span>
							</div>
						</div>

						<div class="relative z-10 flex items-center text-sm font-medium text-ink group-hover:text-canvas group-hover:translate-x-1 transition-all duration-300 pointer-events-none">
							Leer paper
							<svg
								class="ml-2 h-4 w-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M17 8l4 4m0 0l-4 4m4-4H3"
								/>
							</svg>
						</div>
					</article>
				))
			}
		</div>

		<Pagination page={page} />
	</div>
</Layout>
