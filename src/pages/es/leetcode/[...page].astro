---
import Layout from "../../../layouts/Layout.astro";
import Pagination from "../../../components/Pagination.astro";
import LeetCodeFilters from "../../../components/LeetCodeFilters.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../../i18n/ui";
import type { GetStaticPaths, Page } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const solutions = (await getCollection("leetcode"))
		.filter((s) => s.id.startsWith("es/"))
		.sort((a, b) => {
			// Extract number from ID (e.g. es/0001-two-sum.md -> 1)
			const getNum = (id: string) => {
				const match = id.split("/")[1].match(/^(\d+)/);
				return match ? parseInt(match[1]) : 0;
			};
			return getNum(a.id) - getNum(b.id); // Ascending order
		});

	return paginate(solutions, { pageSize: 20 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"leetcode">>;
}

const { page } = Astro.props;
const t = useTranslations("es");

// Border-based difficulty chips -- the semantic color is data, not chrome.
const difficultyColor = {
	Easy: "text-emerald-600 dark:text-emerald-400 border-emerald-500/40",
	Medium: "text-amber-600 dark:text-amber-400 border-amber-500/40",
	Hard: "text-rose-600 dark:text-rose-400 border-rose-500/40",
};
const difficultyLabels = {
	Easy: t("difficulty.easy"),
	Medium: t("difficulty.medium"),
	Hard: t("difficulty.hard"),
};

function getSlug(id: string) {
	return id.replace(/^es\//, "").replace(/\.(md|mdx)$/, "");
}
---

<Layout
	title="LeetCode - eddn.dev"
	prevUrl={page.url.prev}
	nextUrl={page.url.next}
	hreflangs={[{ lang: "en", href: "/leetcode/" }]}
>
	<div class="max-w-7xl mx-auto px-6 py-24">
		<header data-page-header class="mb-16">
			<h1
				class="text-6xl sm:text-8xl font-normal tracking-[-0.04em] text-ink leading-[0.9] mb-8 [&_span]:text-brand-600 dark:[&_span]:text-brand-300"
				set:html={t("leetcode.title")}
			></h1>
			<p class="text-xl text-body font-normal max-w-2xl leading-snug">
				{t("leetcode.description")}
			</p>
		</header>

		<LeetCodeFilters currentFilter="All" baseUrl="/es/leetcode" />

		<div class="overflow-x-auto">
			<table class="w-full text-left border-collapse">
				<thead>
					<tr class="border-b border-hairline">
						<th
							class="py-4 font-mono text-xs uppercase tracking-widest text-mute"
							>{t("leetcode.table.problem")}</th
						>
						<th
							class="py-4 font-mono text-xs uppercase tracking-widest text-mute"
							>{t("leetcode.table.difficulty")}</th
						>
						<th
							class="py-4 font-mono text-xs uppercase tracking-widest text-mute"
							>{t("leetcode.table.complexity")}</th
						>
						<th
							class="py-4 font-mono text-xs uppercase tracking-widest text-mute"
							>{t("leetcode.table.date")}</th
						>
					</tr>
				</thead>
				<tbody>
					{
						page.data.map((solution) => (
							<tr class="border-b border-hairline group hover:bg-canvas-soft transition-colors">
								<td class="py-6">
									<a
										href={`/es/leetcode/${getSlug(solution.id)}`}
										class="font-medium text-ink rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
									>
										<span
											transition:name={`title-${solution.id}`}
										>
											{solution.data.title}
										</span>
									</a>
								</td>
								<td class="py-6">
									<span
										transition:name={`difficulty-${solution.id}`}
										class={`text-[11px] font-mono px-2 py-0.5 rounded-[3px] border ${difficultyColor[solution.data.difficulty]}`}
									>
										{difficultyLabels[solution.data.difficulty]}
									</span>
								</td>
								<td class="py-6 text-sm font-mono text-mute">
									{solution.data.complexity ? (
										<span>
											T: {solution.data.complexity.time} /
											S: {solution.data.complexity.space}
										</span>
									) : (
										<span class="text-mute">N/A</span>
									)}
								</td>
								<td class="py-6 text-sm font-mono text-mute">
									{solution.data.pubDate.toLocaleDateString(
										"es-ES",
										{
											year: "numeric",
											month: "short",
										},
									)}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>

		<Pagination page={page} />
	</div>
</Layout>
