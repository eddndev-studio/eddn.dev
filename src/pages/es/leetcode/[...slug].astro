---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ViewCounter from '../../../components/ViewCounter.astro';
import { useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
	const solutions = await getCollection('leetcode');
	const spanishSolutions = solutions.filter(s => s.id.startsWith('es/'));
	return spanishSolutions.map((solution) => {
		const slug = solution.id.replace(/^es\//, '').replace(/\.(md|mdx)$/, '');
		return {
			params: { slug },
			props: solution,
		};
	});
}

const solution = Astro.props;
const { Content } = await render(solution);

const lang = (Astro.currentLocale as keyof typeof import('../../../i18n/ui').ui) || 'en';
const t = useTranslations(lang);

// Border-based difficulty chip -- the semantic color is data, not chrome.
const difficultyColor = {
	Easy: 'text-emerald-600 dark:text-emerald-400 border-emerald-500/40',
	Medium: 'text-amber-600 dark:text-amber-400 border-amber-500/40',
	Hard: 'text-rose-600 dark:text-rose-400 border-rose-500/40',
};
const difficultyLabels = {
	Easy: t('difficulty.easy'),
	Medium: t('difficulty.medium'),
	Hard: t('difficulty.hard'),
};
---

<Layout title={`${solution.data.title} - Solución de LeetCode`} description={`Implementación y análisis de complejidad para ${solution.data.title} en LeetCode.`}>
	<div class="max-w-7xl mx-auto px-6 py-24 lg:py-32" data-pagefind-body data-pagefind-filter="type:Solution">
		<header class="mb-16 lg:mb-24 max-w-4xl">
			<div class="flex items-center gap-4 mb-6">
				<span
					transition:name={`difficulty-${solution.id}`}
					class={`text-[11px] font-mono px-2 py-0.5 rounded-[3px] border ${difficultyColor[solution.data.difficulty]}`}
				>
					{difficultyLabels[solution.data.difficulty].toUpperCase()}
				</span>
				<div class="h-px bg-hairline w-8"></div>
				<a href={solution.data.problemUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-mute hover:text-ink transition-colors flex items-center gap-1 group rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
					{t('leetcode.problem')}
					<svg class="w-3 h-3 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
				</a>
				<div class="h-1 w-1 rounded-full bg-hairline"></div>
				<ViewCounter slug={`leetcode-${solution.id.replace('/', '-')}`} />
			</div>

			<h1
				transition:name={`title-${solution.id}`}
				class="text-4xl sm:text-6xl font-semibold tracking-[-0.03em] text-ink leading-[0.95] mb-8"
			>
				{solution.data.title}
			</h1>
		</header>

		<div id="main-content-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
			<!-- Sidebar / Complexity Stats -->
			<aside id="sidebar-container" class="hidden lg:block lg:col-span-3 relative">
				<div id="sidebar-inner" class="space-y-8">
					<div class="p-6 bg-canvas-soft rounded-md border border-hairline space-y-6">
						<div>
							<span class="text-[10px] font-mono uppercase tracking-widest text-mute block mb-2">{t('leetcode.time_complexity')}</span>
							<span class="font-medium text-2xl text-ink">{solution.data.complexity?.time || 'N/A'}</span>
						</div>
						<div class="w-full h-px bg-hairline"></div>
						<div>
							<span class="text-[10px] font-mono uppercase tracking-widest text-mute block mb-2">{t('leetcode.space_complexity')}</span>
							<span class="font-medium text-2xl text-ink">{solution.data.complexity?.space || 'N/A'}</span>
						</div>
					</div>

					<a href="/es/leetcode/" class="inline-flex items-center text-sm font-medium text-body hover:text-ink transition-colors group rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
						<svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
						{t('leetcode.back')}
					</a>
				</div>
			</aside>

			<!-- Mobile Stats (Visible only on small screens) -->
			<div class="lg:hidden grid grid-cols-2 gap-4">
				<div class="p-4 bg-canvas-soft rounded-md border border-hairline">
					<span class="text-[10px] font-mono uppercase tracking-widest text-mute block mb-1">{t('home.time')}</span>
					<span class="font-medium text-lg text-ink">{solution.data.complexity?.time || 'N/A'}</span>
				</div>
				<div class="p-4 bg-canvas-soft rounded-md border border-hairline">
					<span class="text-[10px] font-mono uppercase tracking-widest text-mute block mb-1">{t('home.space')}</span>
					<span class="font-medium text-lg text-ink">{solution.data.complexity?.space || 'N/A'}</span>
				</div>
			</div>

			<!-- Main Content -->
			<article class="lg:col-span-8 lg:col-start-5">
				<div class="prose prose-lg max-w-none
					prose-headings:font-medium prose-headings:tracking-tight
					prose-a:font-medium prose-a:underline prose-a:underline-offset-2 prose-a:decoration-mute hover:prose-a:decoration-ink
					prose-pre:rounded-md
					prose-img:rounded-md">
					<Content />
				</div>

				<div class="mt-24 pt-12 border-t border-hairline flex justify-between items-center lg:hidden">
					<a href="/es/leetcode/" class="inline-flex items-center text-sm font-medium text-body hover:text-ink transition-colors group rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
						<svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
						{t('leetcode.back')}
					</a>
				</div>
			</article>
		</div>
	</div>
</Layout>

<script>
	import '../../../utils/codeUtils';
	import { initStickySidebar } from '../../../utils/stickySidebar';

	let cleanup: (() => void) | undefined;

	function setupSticky() {
		cleanup = initStickySidebar('#sidebar-inner', '#main-content-grid', 128);
	}

	function teardownSticky() {
		if (cleanup) cleanup();
	}

	document.addEventListener('astro:page-load', setupSticky);
	document.addEventListener('astro:before-swap', teardownSticky);
</script>
