---
import { useTranslations } from "../i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";

const lang = (Astro.currentLocale as keyof typeof import("../i18n/ui").ui) || "en";
const t = useTranslations(lang);

const navItems = [
	{ name: t("nav.blog"), href: lang === "es" ? "/es/blog/" : "/blog/" },
	{ name: t("nav.articles"), href: lang === "es" ? "/es/articles/" : "/articles/" },
	{ name: t("nav.trajectory"), href: lang === "es" ? "/es/trajectory/" : "/trajectory/" },
	{ name: t("nav.leetcode"), href: lang === "es" ? "/es/leetcode/" : "/leetcode/" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const currentYear = new Date().getFullYear();
---

<header
	id="main-header"
	class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)]"
>
	<nav
		class="mx-auto grid h-20 max-w-[1400px] grid-cols-12 items-center px-4 sm:px-6 lg:px-8"
		aria-label={t("nav.primary_label")}
	>
		<a
			href={lang === "es" ? "/es/" : "/"}
			class="header-logo group col-span-7 flex h-11 items-center gap-3 text-ink sm:col-span-8 lg:col-span-3"
		>
			<span class="text-[15px] font-semibold tracking-[-0.04em]">eddn.dev</span>
			<span class="font-mono text-[11px] uppercase tracking-[0.18em] text-brand-600 transition-colors duration-300 group-hover:text-ink dark:text-brand-300">/ EA</span>
		</a>

		<div data-nav-desktop class="hidden lg:flex lg:col-span-9 lg:items-center lg:justify-end lg:gap-7 xl:gap-9">
			<ul class="flex items-center gap-5 xl:gap-7">
				{navItems.map((item, index) => (
					<li>
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class="group flex h-11 items-center gap-1.5 text-[12px] font-medium text-mute transition-colors duration-300 hover:text-ink aria-[current=page]:text-ink"
						>
							<span class="font-mono text-[11px] text-mute/75">0{index + 1}</span>
							<span class="relative after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-brand-500 after:transition-transform after:duration-300 group-hover:after:scale-x-100 group-aria-[current=page]:after:scale-x-100">
								{item.name}
							</span>
						</a>
					</li>
				))}
			</ul>

			<span class="h-5 w-px bg-hairline" aria-hidden="true"></span>
			<LanguagePicker />
			<button
				type="button"
				aria-label={t("nav.search")}
				class="search-trigger group flex h-11 items-center gap-2 text-[11px] font-medium uppercase tracking-[0.08em] text-mute transition-colors duration-300 hover:text-ink"
			>
				<svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
				</svg>
				<span class="hidden xl:inline">{t("nav.search")}</span>
			</button>
		</div>

		<div data-nav-compact class="col-span-5 flex justify-end sm:col-span-4 lg:hidden">
			<button
				id="menu-toggle"
				type="button"
				aria-label={t("nav.menu")}
				aria-controls="mobile-menu"
				aria-expanded="false"
				data-menu-label={t("nav.menu")}
				data-close-label={t("nav.close")}
				class="header-action group flex h-11 items-center gap-3 text-[11px] font-medium uppercase tracking-[0.12em] text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-brand-500"
			>
				<span data-menu-label>{t("nav.menu")}</span>
				<span class="relative block h-3 w-5" aria-hidden="true">
					<span class="menu-line absolute left-0 top-[3px] h-px w-5 bg-ink transition-transform duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] group-[.is-open]:translate-y-[3px] group-[.is-open]:rotate-45"></span>
					<span class="menu-line absolute bottom-[3px] left-0 h-px w-5 bg-ink transition-transform duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] group-[.is-open]:-translate-y-[3px] group-[.is-open]:-rotate-45"></span>
				</span>
			</button>
		</div>
	</nav>
</header>

<div
	id="mobile-menu"
	aria-hidden="true"
	class="fixed inset-0 z-40 flex min-h-[100dvh] flex-col bg-canvas px-4 pb-6 pt-24 text-ink opacity-0 invisible transition-[opacity,visibility] duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] sm:px-6 lg:hidden"
>
	<div class="mx-auto flex w-full max-w-[1400px] flex-1 flex-col justify-between">
		<nav class="border-b border-hairline" aria-label={t("nav.compact_label")}>
			{navItems.map((item, index) => (
				<a
					href={item.href}
					aria-current={isActive(item.href) ? "page" : undefined}
					style={`--menu-delay:${index * 55}ms`}
					class="mobile-link group grid grid-cols-[2.25rem_1fr_auto] items-baseline border-t border-hairline py-4 text-[clamp(2.4rem,10vw,5rem)] font-semibold leading-[0.9] tracking-[-0.065em] transition-colors duration-300 hover:text-brand-600 aria-[current=page]:text-brand-600 dark:hover:text-brand-300 dark:aria-[current=page]:text-brand-300 sm:py-5"
				>
					<span class="font-mono text-[11px] font-normal tracking-[0.1em] text-mute">0{index + 1}</span>
					<span>{item.name}</span>
					<span class="text-xl font-normal opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">-&gt;</span>
				</a>
			))}
		</nav>

		<div class="grid grid-cols-[1fr_auto_1fr] border-t border-hairline font-mono text-[11px] uppercase tracking-[0.14em] text-mute">
			<button type="button" class="search-trigger mobile-search-trigger h-12 text-left transition-colors hover:text-ink sm:h-14">{t("nav.search")}</button>
			<div class="flex h-12 items-center sm:h-14"><LanguagePicker /></div>
			<span class="flex h-12 items-center justify-end sm:h-14">(c) {currentYear}</span>
		</div>
	</div>
</div>

<style>
	.mobile-link {
		opacity: 0;
		transform: translateY(1rem);
	}
	#mobile-menu.visible .mobile-link {
		animation: mobile-link-in 0.65s cubic-bezier(0.32, 0.72, 0, 1) var(--menu-delay) both;
	}
	@keyframes mobile-link-in {
		to { opacity: 1; transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-link { opacity: 1; transform: none; }
		#mobile-menu.visible .mobile-link { animation: none; }
	}
</style>

<script>
	let headerAbort: AbortController | null = null;

	function setupHeader() {
		headerAbort?.abort();
		headerAbort = new AbortController();
		const { signal } = headerAbort;
		const header = document.getElementById("main-header");
		const toggle = document.getElementById("menu-toggle");
		const menu = document.getElementById("mobile-menu");
		const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");

		if (!header || !toggle || !menu) return;

		const updateHeader = () => {
			header.classList.toggle("header-scrolled", window.scrollY > 16);
		};

		const closeMenu = (restoreFocus = false) => {
			toggle.classList.remove("is-open");
			toggle.setAttribute("aria-expanded", "false");
			menu.setAttribute("aria-hidden", "true");
			menu.classList.remove("visible", "opacity-100");
			menu.classList.add("invisible", "opacity-0");
			header.classList.remove("menu-open");
			document.body.style.overflow = "";
			if (label) label.textContent = toggle.dataset.menuLabel || "Menu";
			if (restoreFocus) toggle.focus();
		};

		const openMenu = () => {
			toggle.classList.add("is-open");
			toggle.setAttribute("aria-expanded", "true");
			menu.setAttribute("aria-hidden", "false");
			menu.classList.remove("invisible", "opacity-0");
			menu.classList.add("visible", "opacity-100");
			header.classList.add("menu-open");
			document.body.style.overflow = "hidden";
			if (label) label.textContent = toggle.dataset.closeLabel || "Close";
			requestAnimationFrame(() => menu.querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: true }));
		};

		closeMenu();
		updateHeader();
		window.addEventListener("scroll", updateHeader, { passive: true, signal });
		toggle.addEventListener("click", () => {
			if (toggle.classList.contains("is-open")) closeMenu();
			else openMenu();
		}, { signal });
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => closeMenu(), { signal });
		});
		menu.querySelector(".mobile-search-trigger")?.addEventListener("click", () => closeMenu(), { signal });
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && toggle.classList.contains("is-open")) closeMenu(true);
		}, { signal });
		window.matchMedia("(min-width: 1024px)").addEventListener("change", () => closeMenu(), { signal });
	}

	function cleanupHeader() {
		headerAbort?.abort();
		headerAbort = null;
		document.body.style.overflow = "";
	}

	document.addEventListener("astro:page-load", setupHeader);
	document.addEventListener("astro:before-swap", cleanupHeader);
</script>
