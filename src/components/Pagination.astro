---
import type { Page } from "astro";
import { useTranslations } from "../i18n/ui";

interface Props {
    page: Page<any>;
}

const { page } = Astro.props;
const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);

// Helper to ensure trailing slash
const ensureSlash = (path: string) => path.endsWith('/') ? path : `${path}/`;

// Helper to construct URL for any page number
const getPageUrl = (pageNum: number) => {
    const currentPath = Astro.url.pathname;
    let cleanBase = currentPath.replace(/\/(\d+)\/?$/, "").replace(/\/$/, "");
    if (!cleanBase) cleanBase = "/";

    if (pageNum === 1) {
        return cleanBase === "/" ? "/" : `${cleanBase}/`;
    }
    return `${cleanBase === "/" ? "" : cleanBase}/${pageNum}/`;
};

const pad = (n: number) => String(n).padStart(2, '0');
const progress = (page.currentPage / page.lastPage) * 100;
---

{
    page.lastPage > 1 && (
        <nav class="mt-20 space-y-6">
            {/* Label + counter */}
            <div class="flex items-center justify-between border-b border-hairline pb-4">
                <span class="font-mono text-xs uppercase tracking-widest text-mute">
                    {t('pagination.page')}
                </span>
                <span class="font-mono text-xs tracking-widest text-mute">
                    {pad(page.currentPage)} / {pad(page.lastPage)}
                </span>
            </div>

            {/* Progress bar (neutral -- structure, not signal) */}
            <div class="h-0.5 bg-hairline overflow-hidden">
                <div
                    class="h-full bg-ink transition-all duration-500 ease-out"
                    style={`width: ${progress}%`}
                />
            </div>

            {/* Navigation row */}
            <div class="flex items-center justify-between">
                {/* Previous */}
                <div class="flex-1">
                    {page.url.prev ? (
                        <a
                            href={ensureSlash(page.url.prev)}
                            class="group inline-flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-ink hover:text-mute transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
                        >
                            <span class="inline-block w-6 h-px bg-mute group-hover:bg-ink group-hover:w-10 transition-all duration-300" />
                            {t('pagination.prev')}
                        </a>
                    ) : (
                        <span class="inline-flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-mute cursor-default">
                            <span class="inline-block w-6 h-px bg-hairline" />
                            {t('pagination.prev')}
                        </span>
                    )}
                </div>

                {/* Page numbers — desktop */}
                <div class="hidden sm:flex items-center gap-1">
                    {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(
                        (pageNum) => {
                            const active = pageNum === page.currentPage;
                            return (
                                <a
                                    href={getPageUrl(pageNum)}
                                    aria-current={active ? "page" : undefined}
                                    class={`group relative px-3 py-2 font-mono text-xs tracking-widest transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 ${
                                        active
                                            ? "text-brand-600 dark:text-brand-400"
                                            : "text-mute hover:text-ink"
                                    }`}
                                >
                                    {pad(pageNum)}
                                    {/* Active marker == the page-location LED */}
                                    {active && (
                                        <span class="absolute bottom-0 left-3 right-3 h-0.5 bg-brand-500" />
                                    )}
                                </a>
                            );
                        },
                    )}
                </div>

                {/* Next */}
                <div class="flex-1 flex justify-end">
                    {page.url.next ? (
                        <a
                            href={ensureSlash(page.url.next)}
                            class="group inline-flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-ink hover:text-mute transition-colors rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
                        >
                            {t('pagination.next')}
                            <span class="inline-block w-6 h-px bg-mute group-hover:bg-ink group-hover:w-10 transition-all duration-300" />
                        </a>
                    ) : (
                        <span class="inline-flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-mute cursor-default">
                            {t('pagination.next')}
                            <span class="inline-block w-6 h-px bg-hairline" />
                        </span>
                    )}
                </div>
            </div>
        </nav>
    )
}
