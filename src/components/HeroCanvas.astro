---
// The hero "FRAMEBUFFER": a terminal window running one of three real
// simulations (fluid.sim / life.run / field.flow) rendered as monospace glyphs.
// All chrome is Warp-system; the only color is emitted by the computation.
---

<div class="hero-term w-full select-none">
  <!-- Double-bezel: hairline tray + inset terminal core -->
  <div class="rounded-md border border-hairline bg-canvas-soft p-1.5">
    <div class="overflow-hidden rounded-[3px] bg-[#1c1916] ring-1 ring-black/30">
      <!-- Title bar -->
      <div class="flex h-8 items-center justify-between border-b border-white/5 px-3 font-mono text-[11px] text-mute">
        <div class="flex items-center gap-2">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
            <span class="h-2 w-2 rounded-full bg-white/15"></span>
          </span>
          <span data-term-title>eddn -- fluid.sim</span>
        </div>
        <span data-term-seed class="hidden sm:inline tracking-wider">[ SEED -------- ]</span>
      </div>

      <!-- Canvas viewport -->
      <div
        class="hero-canvas-wrap relative grid h-[clamp(300px,44vh,460px)] place-items-center overflow-hidden bg-[#1c1916]"
      >
        <!-- No-JS / pre-paint fallback: literal ASCII -->
        <pre
          data-term-fallback
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 m-0 flex items-center justify-center whitespace-pre font-mono text-[10px] leading-[1.15] text-brand-500/50"
        >{`      .:-=+**+=-:.
   .-=+*#%@@@%#*+=-.
  :=*#%@@@@@@@@@%#*=:
 -+#%@@@@@@@@@@@@@%#+-
 =*%@@@@@@@@@@@@@@@%*=
 -+#%@@@@@@@@@@@@@%#+-
  :=*#%@@@@@@@@@%#*=:
   .-=+*#%@@@%#*+=-.
      .:-=+**+=-:.       `}</pre>
        <canvas
          id="hero-canvas"
          class="relative block"
          aria-label="Live generative simulation rendered as terminal glyphs"
        ></canvas>
        <!-- Scanline wipe overlay (program switch) -->
        <div
          data-term-wipe
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 opacity-0"
        ></div>
      </div>

      <!-- Status / switcher bar -->
      <div class="flex h-9 items-center justify-between border-t border-white/5 px-3 font-mono text-[11px] text-mute">
        <span data-term-status class="tracking-wider">[ BOOTING ]</span>
        <button
          type="button"
          data-term-next
          class="group/next inline-flex items-center gap-1.5 rounded-[3px] px-2 py-1 text-white/70 transition-colors hover:bg-white/5 hover:text-brand-300 focus-visible:outline focus-visible:outline-1 focus-visible:outline-brand-400"
          aria-label="Next program"
        >
          <span class="opacity-60 transition-transform group-hover/next:translate-x-0.5">[ &gt; </span>
          <span data-term-next-label>NEXT</span>
          <span class="opacity-60"> ]</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hint line under the window -->
  <p class="mt-3 px-1 font-mono text-[11px] text-mute">
    <span class="text-brand-400">&gt;</span> drag to disturb the field
    <span class="mx-1.5 opacity-40">/</span> click to pulse
    <span class="mx-1.5 opacity-40">/</span> <span class="text-body-strong">[ &gt; NEXT ]</span> to switch programs
  </p>
</div>

<style>
  [data-term-wipe] {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(139, 92, 246, 0.0) 42%,
      rgba(139, 92, 246, 0.55) 50%,
      rgba(139, 92, 246, 0.0) 58%,
      transparent 100%
    );
  }
  .is-wiping [data-term-wipe] {
    animation: term-wipe 0.5s cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  @keyframes term-wipe {
    0% {
      opacity: 0;
      transform: translateY(-100%);
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-wiping [data-term-wipe] {
      animation: none;
    }
  }
</style>

<script>
  import { HeroEngine, type HeroState } from "../lib/hero/HeroEngine";

  let engine: HeroEngine | null = null;
  let heroAbort: AbortController | null = null;

  function pad(s: string, n: number) {
    return s.length >= n ? s : s + " ".repeat(n - s.length);
  }

  function initHero() {
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const root = canvas.closest(".hero-term");
    if (!root) return; // not the hero terminal (defensive vs. id reuse)

    // Full teardown first -- safe on the initial run (null no-ops).
    cleanupHero();
    heroAbort = new AbortController();
    const { signal } = heroAbort;

    const titleEl = root?.querySelector<HTMLElement>("[data-term-title]");
    const seedEl = root?.querySelector<HTMLElement>("[data-term-seed]");
    const statusEl = root?.querySelector<HTMLElement>("[data-term-status]");
    const nextLabelEl = root?.querySelector<HTMLElement>("[data-term-next-label]");
    const fallbackEl = root?.querySelector<HTMLElement>("[data-term-fallback]");
    const wrapEl = root?.querySelector<HTMLElement>(".hero-canvas-wrap");
    const nextBtn = root?.querySelector<HTMLButtonElement>("[data-term-next]");

    const onState = (s: HeroState) => {
      if (titleEl) titleEl.textContent = `eddn -- ${s.name}`;
      if (seedEl) seedEl.textContent = `[ SEED ${s.seed} ]`;
      if (nextLabelEl) {
        const labels = ["FLUID", "LIFE", "FLOW"];
        const nextLabel = labels[(s.index + 1) % s.count] || "NEXT";
        nextLabelEl.textContent = nextLabel;
      }
      if (statusEl) {
        const prog = `${String(s.index + 1).padStart(2, "0")}/${String(s.count).padStart(2, "0")}`;
        const motion = s.reducedMotion ? "STILL" : `${pad(String(s.fps), 2)}FPS`;
        statusEl.textContent = `[ ${pad(s.label, 5)} ${prog} | ${motion} ]`;
      }
    };

    engine = new HeroEngine(canvas, { date: new Date(), onState });
    engine.init();

    // Canvas painted -> hide the ASCII fallback.
    if (fallbackEl) fallbackEl.style.display = "none";

    const triggerWipe = () => {
      if (!wrapEl) return;
      wrapEl.classList.remove("is-wiping");
      // force reflow so the animation restarts
      void wrapEl.offsetWidth;
      wrapEl.classList.add("is-wiping");
    };

    nextBtn?.addEventListener(
      "click",
      () => {
        engine?.next();
        triggerWipe();
      },
      { signal },
    );
    // Program switching is via the visible, focusable NEXT button (Enter/Space).
    // No global Tab interception -- that would trap keyboard focus traversal.
  }

  function cleanupHero() {
    heroAbort?.abort();
    heroAbort = null;
    if (engine) {
      engine.destroy();
      engine = null;
    }
  }

  document.addEventListener("astro:page-load", initHero);
  document.addEventListener("astro:before-swap", cleanupHero);
</script>
