---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/ui";
import HeroCanvas from "../HeroCanvas.astro";

interface Props {
	lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title="404 - Not Found">
	<div class="relative max-w-7xl mx-auto px-6 overflow-visible">
		<div class="relative min-h-[100dvh] flex items-center py-24 sm:py-32">
			<div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center w-full">
				<!-- Left Column: Content -->
				<header class="space-y-8 relative z-10">
					<div class="space-y-5">
						<span class="inline-flex items-center gap-2 font-mono text-xs tracking-wider text-mute mb-1">
							<span class="text-mute/70">eddn@dev:~$</span>
							<span class="text-body-strong">cat {lang === 'es' ? 'ruta' : 'route'}</span>
						</span>

						<h1
							class="text-5xl sm:text-7xl font-normal tracking-[-0.04em] text-ink leading-[0.95]"
							set:html={t('error.404.title')}
						>
						</h1>

						<p class="text-xl sm:text-2xl font-normal text-body-strong leading-snug max-w-xl">
							{t('error.404.subtitle')}
						</p>
					</div>

					<p
						class="text-base sm:text-lg text-body font-normal leading-relaxed max-w-xl border-l border-hairline pl-4"
					>
						{t('error.404.description')}
					</p>

					<div class="flex flex-wrap gap-3 pt-2">
						<a
							href={lang === 'es' ? "/es/" : "/"}
							class="group inline-flex items-center gap-2.5 pl-5 pr-2 py-2 bg-ink text-canvas text-sm font-medium rounded-[4px] transition-transform active:scale-[0.98]"
						>
							{t('error.404.home_btn')}
							<span class="flex items-center justify-center w-6 h-6 rounded-[3px] bg-canvas/15 transition-transform group-hover:translate-x-0.5">
								<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
							</span>
						</a>
						<a
							href={lang === 'es' ? "/es/blog/" : "/blog/"}
							class="inline-flex items-center px-5 py-2 text-ink text-sm font-medium rounded-[4px] border border-hairline hover:bg-canvas-soft transition-colors"
						>
							{t('error.404.blog_btn')}
						</a>
					</div>
				</header>

				<!-- Right Column: live terminal -->
				<div class="relative z-10">
					<HeroCanvas />
				</div>
			</div>
		</div>
	</div>
</Layout>
