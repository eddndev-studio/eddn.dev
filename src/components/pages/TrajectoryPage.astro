---
import Layout from '../../layouts/Layout.astro';
import { trajectoryData } from '../../i18n/trajectory';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const data = trajectoryData[lang];
---

<Layout title={`${lang === 'es' ? 'Trayectoria' : 'Trajectory'} - eddn.dev`}>
	<div class="max-w-7xl mx-auto px-6 py-24">
		<header class="mb-20">
			<h1
				class="mb-8 text-6xl font-semibold leading-[0.9] tracking-[-0.055em] text-ink [&_span]:text-brand-600 dark:[&_span]:text-brand-300 sm:text-8xl"
        set:html={data.title}
			>
			</h1>
			<p class="text-xl text-body font-normal max-w-2xl leading-snug">
				{data.description}
			</p>
		</header>

		<div class="relative space-y-12">
			<div class="absolute left-0 top-0 bottom-0 w-px bg-hairline ml-[7px]"></div>

			{data.milestones.map((milestone) => (
				<div class="relative pl-10">
					<div class="absolute left-0 top-2 w-4 h-4 rounded-full border-4 border-canvas bg-ink ring-1 ring-hairline"></div>
					<div class="space-y-2">
						<span class="font-mono text-sm text-mute uppercase tracking-widest">{milestone.year}</span>
						<h3 class="text-2xl font-medium text-ink">{milestone.title}</h3>
						<p class="text-lg font-normal text-mute">{milestone.company}</p>
						<p class="text-body max-w-2xl leading-relaxed">
							{milestone.description}
						</p>
						{milestone.link && (
							<a
								href={milestone.link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-sm font-medium text-ink hover:text-mute transition-colors mt-1 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
							>
								{milestone.link.text}
								<svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
								</svg>
							</a>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>
