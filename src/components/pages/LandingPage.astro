---
import { getCollection } from "astro:content";
import GitHubContributions from "../GitHubContributions.astro";
import GitHubLanguages from "../GitHubLanguages.astro";
import KineticField from "../KineticField.astro";
import LeetCodeContributions from "../LeetCodeContributions.astro";
import { socials } from "../../data/socials";
import { useTranslations } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";

interface Props {
	lang: "en" | "es";
}

interface IndexEntry {
	id: string;
	index: string;
	label: string;
	title: string;
	description: string;
	href: string;
	date?: Date;
	detail?: string;
	detailClass?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

function filterByLang(entry: { id: string }) {
	return entry.id.split("/")[0] === lang;
}

function getSlug(id: string) {
	return id.split("/").slice(1).join("/").replace(/\.(md|mdx)$/, "");
}

const latestBlog = (await getCollection("blog"))
	.filter(filterByLang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const latestArticle = (await getCollection("articles"))
	.filter(filterByLang)
	.filter((entry: { data: { draft?: boolean } }) => !entry.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const latestLeetCode = (await getCollection("leetcode"))
	.filter(filterByLang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const difficultyColor = {
	Easy: "text-emerald-700 dark:text-emerald-300",
	Medium: "text-amber-700 dark:text-amber-300",
	Hard: "text-rose-700 dark:text-rose-300",
};

const difficultyLabel = (difficulty: string) => {
	const key = `difficulty.${difficulty.toLowerCase()}`;
	// @ts-ignore - difficulty is validated by the content collection.
	return t(key) || difficulty;
};

const formatDate = (date: Date) =>
	date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
		month: "short",
		day: "2-digit",
		year: "numeric",
	});

const blogIndexUrl = lang === "es" ? "/es/blog/" : "/blog/";
const localUrl = (section: string, id: string) =>
	lang === "es" ? `/es/${section}/${getSlug(id)}/` : `/${section}/${getSlug(id)}/`;

const entries: IndexEntry[] = [];

if (latestBlog) {
	entries.push({
		id: latestBlog.id,
		index: "01",
		label: t("home.latest_post_label"),
		title: latestBlog.data.title,
		description: latestBlog.data.description,
		href: localUrl("blog", latestBlog.id),
		date: latestBlog.data.pubDate,
	});
}

if (latestArticle) {
	entries.push({
		id: latestArticle.id,
		index: "02",
		label: t("home.latest_article_label"),
		title: latestArticle.data.title,
		description: latestArticle.data.description,
		href: localUrl("articles", latestArticle.id),
		date: latestArticle.data.pubDate,
		detail: latestArticle.data.technicalDepth,
	});
}

if (latestLeetCode) {
	const complexity = latestLeetCode.data.complexity;
	entries.push({
		id: latestLeetCode.id,
		index: "03",
		label: t("home.latest_solution_label"),
		title: latestLeetCode.data.title,
		description: t("home.complexity_analysis"),
		href: localUrl("leetcode", latestLeetCode.id),
		detail: [
			difficultyLabel(latestLeetCode.data.difficulty),
			complexity ? `${t("home.time")} ${complexity.time}` : undefined,
			complexity ? `${t("home.space")} ${complexity.space}` : undefined,
		].filter(Boolean).join(" / "),
		detailClass: difficultyColor[latestLeetCode.data.difficulty as keyof typeof difficultyColor],
	});
}
---

<Layout title="eddn.dev - Eduardo Alonso">
	<section data-hero-section class="flex flex-col">
		<div data-hero-content class="relative z-10 mx-auto grid w-full max-w-[1400px] grid-cols-1 content-center gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-24">
			<div class="lg:col-span-8">
				<div class="mb-8 flex items-center gap-4 sm:mb-10">
					<span class="font-mono text-[11px] uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300">01 / {t("home.index_label")}</span>
					<span class="h-px w-10 bg-hairline" aria-hidden="true"></span>
					<span class="font-mono text-[11px] uppercase tracking-[0.18em] text-mute">{t("home.greeting")}</span>
				</div>

				<h1
					class="max-w-[10ch] text-[clamp(3.8rem,8.8vw,8.75rem)] font-semibold leading-[0.8] tracking-[-0.078em] text-ink [&_span]:text-brand-600 dark:[&_span]:text-brand-300"
					set:html={t("home.title")}
				></h1>
			</div>

			<div class="flex flex-col justify-end gap-8 lg:col-span-4 lg:pb-2">
				<p class="max-w-[26ch] text-[clamp(1.35rem,2.2vw,2rem)] font-medium leading-[1.05] tracking-[-0.045em] text-body-strong">
					{t("home.subtitle")}
				</p>
				<p class="max-w-[39ch] text-sm leading-relaxed text-body sm:text-base">{t("home.description")}</p>
				<div class="flex flex-wrap items-center gap-x-8 gap-y-4">
					<a
						href={latestBlog ? localUrl("blog", latestBlog.id) : blogIndexUrl}
						class="group inline-flex items-center gap-3 border-b border-ink pb-1 text-sm font-medium text-ink transition-colors duration-300 hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-300"
					>
						{t("home.latest_blog_btn")}
						<span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">-&gt;</span>
					</a>
					<a
						href={lang === "es" ? "/es/trajectory/" : "/trajectory/"}
						class="text-sm font-medium text-mute transition-colors duration-300 hover:text-ink"
					>
						{t("home.trajectory_btn")}
					</a>
				</div>
				<a href="https://eddndev.com" class="inline-flex items-center font-mono text-[11px] uppercase tracking-[0.15em] text-mute transition-colors hover:text-ink">
					{t("home.availability")}
				</a>

				<div data-hero-links class="flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-hairline pt-5">
					<a
						href="#"
						data-email-cta
						class="group inline-flex items-center gap-3 text-sm font-medium text-ink transition-colors duration-300 hover:text-brand-600 dark:hover:text-brand-300"
					>
						{t("home.contact_link")}
						<span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">-&gt;</span>
					</a>
					<ul data-hero-socials class="flex items-center gap-4" aria-label={t("home.social_label")}>
						{socials.map((social) => (
							<li>
								<a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.label} class="block text-mute transition-[color,transform] duration-300 hover:-translate-y-0.5 hover:text-ink">
									<svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true" set:html={social.icon}></svg>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>

		<div data-hero-slot class="relative z-0 -mt-24 h-[34dvh] min-h-[18rem] max-h-[24rem] sm:-mt-32 lg:-mt-40">
			<KineticField decorative />
		</div>

	</section>

	<div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">
		<section id="latest" class="scroll-mt-24 py-28 sm:py-36 lg:py-44">
			<div class="mb-12 grid gap-6 lg:mb-16 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-8">
					<span class="mb-4 block font-mono text-[11px] uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300">02 / {t("home.content_index_label")}</span>
					<h2 class="text-[clamp(2.8rem,6vw,6.5rem)] font-semibold leading-[0.86] tracking-[-0.07em] text-ink">{t("home.latest_label")}</h2>
				</div>
				<a href={blogIndexUrl} class="group inline-flex items-center gap-3 justify-self-start border-b border-hairline pb-1 text-sm text-body transition-colors duration-300 hover:border-ink hover:text-ink lg:col-span-4 lg:justify-self-end">
					{t("home.view_all")}
					<span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">-&gt;</span>
				</a>
			</div>

			<div class="border-b border-hairline">
				{entries.map((entry) => (
					<article data-entry-row class="group relative grid gap-5 border-t border-hairline py-7 sm:py-9 lg:grid-cols-12 lg:gap-6 lg:py-11">
						<div class="flex items-baseline gap-4 lg:col-span-3">
							<span class="font-mono text-[11px] tracking-[0.12em] text-brand-600 dark:text-brand-300">{entry.index}</span>
							<span class="font-mono text-[11px] uppercase tracking-[0.14em] text-mute">{entry.label}</span>
						</div>
						<div class="lg:col-span-6">
							<h3 transition:name={`title-${entry.id}`} class="text-[clamp(1.8rem,3.4vw,3.75rem)] font-semibold leading-[0.96] tracking-[-0.055em] text-ink transition-colors duration-300 group-hover:text-brand-600 dark:group-hover:text-brand-300">
								<a href={entry.href} class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-500">
									<span class="absolute inset-0"></span>
									{entry.title}
								</a>
							</h3>
							<p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-body sm:text-base">{entry.description}</p>
						</div>
						<div class="flex items-end justify-between gap-5 lg:col-span-3 lg:flex-col lg:items-end">
							<div class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute lg:text-right">
								{entry.date && <time transition:name={`date-${entry.id}`}>{formatDate(entry.date)}</time>}
								{entry.detail && <span class={`block ${entry.detailClass ?? ""}`}>{entry.detail}</span>}
							</div>
							<span class="text-xl text-mute transition-[color,transform] duration-300 group-hover:translate-x-1 group-hover:text-ink" aria-hidden="true">-&gt;</span>
						</div>
					</article>
				))}
			</div>
		</section>

		<section id="proof" class="scroll-mt-24 pb-20 pt-12 sm:pb-28 sm:pt-20">
			<div class="mb-14 grid gap-8 border-t border-hairline pt-5 lg:mb-20 lg:grid-cols-12 lg:items-end">
				<div class="lg:col-span-8">
					<span class="mb-5 block font-mono text-[11px] uppercase tracking-[0.2em] text-brand-600 dark:text-brand-300">03 / {t("home.telemetry_label")}</span>
					<h2 class="text-[clamp(3rem,7vw,7.5rem)] font-semibold leading-[0.82] tracking-[-0.075em] text-ink [&_span]:text-brand-600 dark:[&_span]:text-brand-300" set:html={t("home.telemetry_title")}></h2>
				</div>
				<p class="max-w-[38ch] text-base leading-relaxed text-body lg:col-span-4">{t("home.telemetry_intro")}</p>
			</div>

			<div>
				<GitHubContributions lang={lang} />
				<GitHubLanguages lang={lang} />
				<LeetCodeContributions lang={lang} />
			</div>
		</section>
	</div>
</Layout>
