---
import { socials } from "../data/socials";
import { useTranslations } from "../i18n/ui";

const currentYear = new Date().getFullYear();
const lang = (Astro.currentLocale as keyof typeof import("../i18n/ui").ui) || "en";
const t = useTranslations(lang);

const links = [
	{ name: t("nav.blog"), description: t("footer.blog_desc"), href: lang === "es" ? "/es/blog/" : "/blog/" },
	{ name: t("nav.articles"), description: t("footer.articles_desc"), href: lang === "es" ? "/es/articles/" : "/articles/" },
	{ name: t("nav.leetcode"), description: t("footer.leetcode_desc"), href: lang === "es" ? "/es/leetcode/" : "/leetcode/" },
	{ name: t("nav.trajectory"), description: t("footer.trajectory_desc"), href: lang === "es" ? "/es/trajectory/" : "/trajectory/" },
];
---

<footer class="relative z-20 min-h-[90dvh] overflow-hidden bg-[#17131d] text-[#f3f0ea]">
	<canvas id="footer-gol" class="pointer-events-none absolute inset-0 size-full opacity-[0.07]" aria-hidden="true"></canvas>

	<div class="relative mx-auto flex min-h-[90dvh] max-w-[1400px] flex-col px-4 pb-6 pt-12 sm:px-6 sm:pb-8 sm:pt-16 lg:px-8 lg:pt-20">
		<div class="mb-16 flex items-center justify-between border-b border-white/20 pb-5 font-mono text-[11px] uppercase tracking-[0.2em] text-white/55 sm:mb-24">
			<span>04 / Contact</span>
			<span>Mexico City / {currentYear}</span>
		</div>

		<div class="grid flex-1 gap-12 lg:grid-cols-12 lg:items-end">
			<div class="lg:col-span-8">
				<h2 class="max-w-[11ch] text-[clamp(3.4rem,8vw,8.5rem)] font-semibold leading-[0.8] tracking-[-0.075em] [&_span]:text-brand-300" set:html={t("footer.talk_title")}></h2>
			</div>

			<div class="flex flex-col items-start gap-8 lg:col-span-4 lg:pb-2">
				<p class="max-w-[36ch] text-sm leading-relaxed text-white/65 sm:text-base">{t("footer.talk_desc")}</p>
				<a href="#" data-email-cta class="group inline-flex items-center gap-5 border-b border-white/60 pb-2 text-sm font-medium transition-colors duration-300 hover:border-brand-300 hover:text-brand-300">
					<span>{t("footer.start_conversation")}</span>
					<span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">-&gt;</span>
				</a>
			</div>
		</div>

		<div class="mt-20 grid gap-10 border-t border-white/20 pt-6 lg:grid-cols-12">
			<nav class="lg:col-span-8" aria-label="Footer navigation">
				<ul class="grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4">
					{links.map((link, index) => (
						<li>
							<a href={link.href} class="group block">
								<span class="mb-2 block font-mono text-[11px] text-brand-300">0{index + 1}</span>
								<span class="block text-sm font-medium transition-colors duration-300 group-hover:text-brand-300">{link.name}</span>
								<span class="mt-1 hidden text-[10px] text-white/45 sm:block">{link.description}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="flex flex-wrap items-end justify-between gap-6 lg:col-span-4 lg:justify-end">
				<div class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-[11px] uppercase tracking-[0.12em] text-white/60">
					{socials.map((social) => (
						<a href={social.url} target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-brand-300">{social.id}</a>
					))}
				</div>
				<span class="font-mono text-[11px] uppercase tracking-[0.12em] text-white/40">(c) {currentYear} EDDN.DEV</span>
			</div>
		</div>
	</div>
</footer>

<script>
	import GameOfLife from "../lib/GameOfLife";

	let gol: GameOfLife | null = null;
	let footerAbort: AbortController | null = null;

	function initFooterVisual() {
		gol?.destroy();
		footerAbort?.abort();
		footerAbort = new AbortController();
		const { signal } = footerAbort;

		const canvas = document.getElementById("footer-gol") as HTMLCanvasElement | null;
		if (canvas) {
			gol = new GameOfLife(canvas, "#b7a3fb");
			gol.init();
		}

		document.querySelectorAll<HTMLElement>("[data-email-cta]").forEach((emailCta) => {
			emailCta.addEventListener("click", (event) => {
				event.preventDefault();
				window.location.href = "mailto:" + "contacto" + "@" + "eddndev.com";
			}, { signal });
		});
	}

	function cleanupFooterVisual() {
		footerAbort?.abort();
		footerAbort = null;
		gol?.destroy();
		gol = null;
	}

	document.addEventListener("astro:page-load", initFooterVisual);
	document.addEventListener("astro:before-swap", cleanupFooterVisual);
</script>
