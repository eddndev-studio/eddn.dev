---
import { useTranslations } from '../i18n/ui';
import { socials } from '../data/socials';

const currentYear = new Date().getFullYear();
const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);
---

<footer class="bg-canvas text-ink min-h-[100dvh] flex flex-col justify-center py-24 lg:py-32 border-t border-hairline overflow-hidden relative z-20">
    <canvas id="footer-gol" class="absolute inset-0 w-full h-full opacity-[0.13] dark:opacity-[0.10] pointer-events-none" aria-hidden="true"></canvas>
    <div class="mx-auto max-w-7xl px-6 relative z-10 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">

            <!-- Site Map -->
            <div class="space-y-12 hidden lg:block">
                <h2 class="text-xs font-mono text-mute tracking-[0.2em] uppercase mb-8">{t('footer.explore')}</h2>

                <ul class="space-y-8">
                    <li class="group border-b border-hairline pb-4 hover:border-ink transition-colors">
                        <a href={lang === 'es' ? "/es/blog/" : "/blog/"} class="flex items-baseline justify-between w-full">
                            <span class="text-2xl lg:text-3xl font-normal tracking-tight text-body group-hover:text-ink transition-colors">{t('nav.blog')}</span>
                            <span class="text-sm font-mono text-mute group-hover:text-ink transition-colors">{t('footer.blog_desc')}</span>
                        </a>
                    </li>
                    <li class="group border-b border-hairline pb-4 hover:border-ink transition-colors">
                        <a href={lang === 'es' ? "/es/articles/" : "/articles/"} class="flex items-baseline justify-between w-full">
                            <span class="text-2xl lg:text-3xl font-normal tracking-tight text-body group-hover:text-ink transition-colors">{t('nav.articles')}</span>
                            <span class="text-sm font-mono text-mute group-hover:text-ink transition-colors">{t('footer.articles_desc')}</span>
                        </a>
                    </li>
                    <li class="group border-b border-hairline pb-4 hover:border-ink transition-colors">
                        <a href={lang === 'es' ? "/es/leetcode/" : "/leetcode/"} class="flex items-baseline justify-between w-full">
                            <span class="text-2xl lg:text-3xl font-normal tracking-tight text-body group-hover:text-ink transition-colors">{t('nav.leetcode')}</span>
                            <span class="text-sm font-mono text-mute group-hover:text-ink transition-colors">{t('footer.leetcode_desc')}</span>
                        </a>
                    </li>
                    <li class="group border-b border-hairline pb-4 hover:border-ink transition-colors">
                        <a href={lang === 'es' ? "/es/trajectory/" : "/trajectory/"} class="flex items-baseline justify-between w-full">
                            <span class="text-2xl lg:text-3xl font-normal tracking-tight text-body group-hover:text-ink transition-colors">{t('nav.trajectory')}</span>
                            <span class="text-sm font-mono text-mute group-hover:text-ink transition-colors">{t('footer.trajectory_desc')}</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- CTA / Contact -->
            <div class="flex flex-col justify-between h-full">
                 <div>
                    <h3 class="text-5xl lg:text-7xl font-normal tracking-[-0.03em] leading-[0.95] mb-8 text-ink" set:html={t('footer.talk_title')}>
                    </h3>
                    <p class="text-body text-lg mb-12 max-w-md leading-relaxed">
                        {t('footer.talk_desc')}
                    </p>
                 </div>

                 <div class="flex flex-col sm:flex-row gap-6">
                    <!-- Primary CTA (button-in-button) -->
                    <a href="#" id="email-cta" class="group inline-flex items-center gap-3 pl-6 pr-2.5 py-2.5 bg-ink text-canvas text-sm font-medium rounded-[4px] transition-transform active:scale-[0.98] w-max">
                        <span>{t('footer.start_conversation')}</span>
                        <span class="flex items-center justify-center w-7 h-7 rounded-[3px] bg-canvas/15 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7V16"></path></svg>
                        </span>
                    </a>
                 </div>
            </div>

        </div>

        <!-- Minimal Footer Info -->
        <div class="mt-24 pt-8 border-t border-hairline flex flex-col sm:flex-row justify-between items-center text-xs text-mute font-mono">
            <span>(c) {currentYear} EDDN.DEV. {t('footer.rights')}</span>
            <div class="flex flex-wrap gap-4 mt-4 sm:mt-0 justify-center">
                {socials.map((social) => (
                    <a href={social.url} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">{social.id.toUpperCase()}</a>
                ))}
                <a href="https://eddndev.com" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">EDDNDEV.COM</a>
                <a href="https://achrony.me" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">ACHRONY.ME</a>
            </div>
        </div>
    </div>
</footer>

<script>
    import GameOfLife from "../lib/GameOfLife";

    let gol: GameOfLife | null = null;

    function initFooterVisual() {
        const canvas = document.getElementById('footer-gol') as HTMLCanvasElement;
        if (!canvas) return;

        // Cleanup existing instance if any
        if (gol) {
            gol.destroy();
        }

        // Initialize
        gol = new GameOfLife(canvas, '#8b5cf6');
        gol.init();
        
        // Email Obfuscation Logic (Bypasses Cloudflare Email Protection)
        const emailCta = document.getElementById('email-cta');
        if (emailCta) {
            emailCta.addEventListener('click', (e) => {
                e.preventDefault();
                const user = 'contacto';
                const domain = 'eddndev.com';
                window.location.href = `mailto:${user}@${domain}`;
            });
            // Optional: Set href on hover so status bar looks legit (but might trigger CF if it scans DOM aggressively, though usually it scans static HTML)
            emailCta.addEventListener('mouseover', () => {
                 const user = 'contacto';
                 const domain = 'eddndev.com';
                 emailCta.setAttribute('href', `mailto:${user}@${domain}`);
            });
        }
    }

    function cleanupFooterVisual() {
        if (gol) {
            gol.destroy();
            gol = null;
        }
    }

    // Initialize on every page load (initial + navigation)
    document.addEventListener('astro:page-load', initFooterVisual);
    
    // Cleanup before swapping content
    document.addEventListener('astro:before-swap', cleanupFooterVisual);
</script>
