---
import { useTranslations } from '../i18n/ui';

const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);
---

<el-dialog data-search-lang={lang} data-search-labels={JSON.stringify({
  Blog: t('search.group.Blog'),
  Article: t('search.group.Article'),
  Solution: t('search.group.Solution'),
})}>
  <dialog id="search-dialog" class="backdrop:bg-transparent bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full open:flex items-start justify-center pt-12 sm:pt-20 px-4 sm:px-6">
    <el-dialog-backdrop
      class="fixed inset-0 bg-black/50 backdrop-blur-sm transition duration-200 data-closed:opacity-0"
    />
    <el-dialog-panel class="relative z-10 w-full max-w-2xl">
      <div class="bg-canvas border border-hairline rounded-md shadow-2xl overflow-hidden">
        <el-command-palette id="search-palette">
          <!-- Input -->
          <div class="flex items-center gap-3 border-b border-hairline px-5 h-14">
            <svg class="w-4 h-4 text-mute shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              autofocus
              type="text"
              placeholder={t('search.placeholder')}
              autocomplete="off"
              class="flex-1 bg-transparent text-sm text-ink placeholder:text-mute outline-none font-mono"
            />
            <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono font-bold text-mute border border-hairline rounded-[3px]">
              ESC
            </kbd>
          </div>

          <!-- Results -->
          <el-command-list class="block max-h-[60vh] overflow-y-auto" id="search-results">
          </el-command-list>

          <el-no-results hidden class="px-5 py-12 text-center text-sm text-mute font-mono block">
            {t('search.no_results')}
          </el-no-results>
        </el-command-palette>
      </div>
    </el-dialog-panel>
  </dialog>
</el-dialog>

<script>
  let pagefind: any = null;
  let elementsLoaded = false;
  let debounceTimer: ReturnType<typeof setTimeout>;
  let searchAbort: AbortController | null = null;

  const groupOrder = ['Blog', 'Article', 'Solution'] as const;

  function initSearch() {
    // Drop the previous run's document-level shortcut listener (it persists
    // across view transitions otherwise, accumulating one per navigation).
    searchAbort?.abort();
    searchAbort = new AbortController();
    const dialog = document.querySelector('#search-dialog')?.closest('el-dialog') as any;
    const palette = document.getElementById('search-palette') as any;
    const results = document.getElementById('search-results');
    const input = palette?.querySelector('input') as HTMLInputElement;
    const searchBtns = document.querySelectorAll('.search-trigger');

    if (!dialog || !palette || !results || !input) return;

    const labels: Record<string, string> = JSON.parse(dialog.getAttribute('data-search-labels') || '{}');

    const loadDeps = async () => {
      // Lazy-load Tailwind Plus Elements on first open
      if (!elementsLoaded) {
        await import('@tailwindplus/elements');
        elementsLoaded = true;
        // Wait for custom elements to upgrade
        await customElements.whenDefined('el-dialog');
        palette.setFilterCallback(() => true);
      }

      // Lazy-load Pagefind
      if (!pagefind) {
        try {
          const path = `${window.location.origin}/pagefind/pagefind.js`;
          pagefind = await import(/* @vite-ignore */ path);
          await pagefind.init();
        } catch {
          // Pagefind not available in dev mode
        }
      }
    };

    const open = async () => {
      await loadDeps();
      dialog.show();
    };

    const close = () => {
      dialog.hide();
      input.value = '';
      clearResults();
      palette.reset?.();
    };

    const clearResults = () => {
      results.querySelectorAll('.search-group, .search-result').forEach(el => el.remove());
    };

    const createResultLink = (item: any, closeFn: () => void): HTMLAnchorElement => {
      const a = document.createElement('a');
      a.href = item.url;
      a.className = 'search-result block px-5 py-4 border-b border-hairline last:border-0 hover:bg-canvas-soft focus:bg-canvas-soft transition-colors outline-none group';
      a.innerHTML = `
        <div class="text-sm font-bold text-ink group-hover:text-brand-400 group-focus:text-brand-400 transition-colors">${item.meta?.title || item.url}</div>
        <div class="text-xs text-body mt-1 line-clamp-2 leading-relaxed">${item.excerpt}</div>
      `;
      a.addEventListener('click', closeFn);
      return a;
    };

    const search = async (query: string) => {
      if (!pagefind || !query.trim()) {
        clearResults();
        return;
      }

      const searchLang = dialog.getAttribute('data-search-lang') || 'en';
      const response = await pagefind.search(query, { filters: { lang: searchLang } });
      clearResults();

      if (response.results.length === 0) return;

      const top = response.results.slice(0, 12);
      const data = await Promise.all(top.map((r: any) => r.data()));

      // Group results by type
      const grouped: Record<string, any[]> = {};
      for (const item of data) {
        const type = item.filters?.type?.[0] || 'Other';
        if (!grouped[type]) grouped[type] = [];
        grouped[type].push(item);
      }

      // Render groups in order
      for (const type of groupOrder) {
        const items = grouped[type];
        if (!items || items.length === 0) continue;

        const group = document.createElement('el-command-group');
        group.className = 'search-group block';

        const heading = document.createElement('div');
        heading.className = 'px-5 py-2 text-[10px] font-mono font-bold uppercase tracking-widest text-mute bg-canvas-soft border-b border-hairline sticky top-0';
        heading.textContent = labels[type] || type;
        group.appendChild(heading);

        for (const item of items) {
          group.appendChild(createResultLink(item, close));
        }

        results.appendChild(group);
      }
    };

    // Listen to input changes
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => search(input.value), 200);
    });

    // Search trigger buttons
    searchBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      });
    });

    // Cmd/Ctrl+K and "/" shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
        return;
      }
      if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const tag = (document.activeElement?.tagName || '').toLowerCase();
        if (tag === 'input' || tag === 'textarea') return;
        e.preventDefault();
        open();
      }
    }, { signal: searchAbort.signal });

    // Clean results on close (ESC, click outside, etc.)
    dialog.addEventListener('close', () => {
      input.value = '';
      clearResults();
      palette.reset?.();
    });
  }

  document.addEventListener('astro:page-load', initSearch);
  document.addEventListener('astro:before-swap', () => {
    searchAbort?.abort();
    searchAbort = null;
  });
</script>
