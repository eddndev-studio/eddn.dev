---
import { useTranslations } from '../i18n/ui';

const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);
---

<el-dialog>
  <dialog id="search-dialog" class="backdrop:bg-transparent bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full overflow-visible">
    <el-dialog-backdrop
      class="fixed inset-0 bg-black/50 backdrop-blur-sm transition duration-200 data-closed:opacity-0"
    />
    <el-dialog-panel class="fixed inset-0 flex items-start justify-center pt-12 sm:pt-20 px-4 sm:px-6">
      <div class="w-full max-w-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-2xl overflow-hidden">
        <el-command-palette id="search-palette">
          <!-- Input -->
          <div class="flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 px-5 h-14">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              autofocus
              type="text"
              placeholder={t('search.placeholder')}
              autocomplete="off"
              class="flex-1 bg-transparent text-sm text-slate-900 dark:text-white placeholder:text-slate-400 outline-none font-mono"
            />
            <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono font-bold text-slate-400 border border-slate-200 dark:border-slate-700 rounded">
              ESC
            </kbd>
          </div>

          <!-- Results -->
          <el-command-list class="max-h-[60vh] overflow-y-auto block" id="search-results">
          </el-command-list>

          <el-no-results hidden class="px-5 py-12 text-center text-sm text-slate-400 font-mono block">
            {t('search.no_results')}
          </el-no-results>
        </el-command-palette>
      </div>
    </el-dialog-panel>
  </dialog>
</el-dialog>

<script>
  import '@tailwindplus/elements';

  let pagefind: any = null;
  let debounceTimer: ReturnType<typeof setTimeout>;

  function initSearch() {
    const dialog = document.querySelector('#search-dialog')?.closest('el-dialog') as any;
    const palette = document.getElementById('search-palette') as any;
    const results = document.getElementById('search-results');
    const input = palette?.querySelector('input') as HTMLInputElement;
    const searchBtns = document.querySelectorAll('.search-trigger');

    if (!dialog || !palette || !results || !input) return;

    // Bypass command palette's built-in filtering — Pagefind handles it
    function setupPalette() {
      if (palette.setFilterCallback) {
        palette.setFilterCallback(() => true);
      } else {
        window.addEventListener('elements:ready', () => {
          palette.setFilterCallback(() => true);
        });
      }
    }
    setupPalette();

    const loadPagefind = async () => {
      if (!pagefind) {
        try {
          const path = `${window.location.origin}/pagefind/pagefind.js`;
          pagefind = await import(/* @vite-ignore */ path);
          await pagefind.init();
        } catch {
          // Pagefind not available in dev mode
        }
      }
    };

    const open = async () => {
      dialog.show();
      await loadPagefind();
    };

    const close = () => {
      dialog.hide();
      input.value = '';
      results.querySelectorAll('.search-result').forEach(el => el.remove());
      palette.reset?.();
    };

    const search = async (query: string) => {
      if (!pagefind || !query.trim()) {
        results.querySelectorAll('.search-result').forEach(el => el.remove());
        return;
      }

      const response = await pagefind.search(query);
      results.querySelectorAll('.search-result').forEach(el => el.remove());

      if (response.results.length === 0) return;

      const top = response.results.slice(0, 8);
      const data = await Promise.all(top.map((r: any) => r.data()));

      for (const item of data) {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'search-result block px-5 py-4 border-b border-slate-100 dark:border-slate-800 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-900 focus:bg-slate-50 dark:focus:bg-slate-900 transition-colors outline-none group';
        a.innerHTML = `
          <div class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-brand-600 group-focus:text-brand-600 transition-colors">${item.meta?.title || item.url}</div>
          <div class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">${item.excerpt}</div>
          <div class="text-[10px] font-mono text-slate-400 mt-1.5">${item.url}</div>
        `;
        a.addEventListener('click', close);
        results.appendChild(a);
      }
    };

    // Listen to input changes
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => search(input.value), 200);
    });

    // Search trigger buttons
    searchBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      });
    });

    // Cmd/Ctrl+K shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
    });

    // Clean results on close
    dialog.addEventListener('close', () => {
      input.value = '';
      results.querySelectorAll('.search-result').forEach(el => el.remove());
      palette.reset?.();
    });
  }

  document.addEventListener('astro:page-load', initSearch);
</script>
