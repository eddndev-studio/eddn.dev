---
import { useTranslations } from "../i18n/ui";

interface Props {
    currentFilter?: "All" | "Easy" | "Medium" | "Hard";
    baseUrl?: string;
}

const { currentFilter = "All", baseUrl = "/leetcode" } = Astro.props;
const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);

// Neutral Warp chips. `key` is the stable English value (active comparison +
// difficulty data); `label` is localized chrome. The leading dot is the only
// color and it is semantic (the difficulty category itself) -- legend, not chrome.
const filters = [
    { key: "All", label: t('leetcode.filter_all'), href: `${baseUrl}`, dot: "" },
    { key: "Easy", label: t('difficulty.easy'), href: `${baseUrl}/difficulty/easy`, dot: "bg-emerald-500" },
    { key: "Medium", label: t('difficulty.medium'), href: `${baseUrl}/difficulty/medium`, dot: "bg-amber-500" },
    { key: "Hard", label: t('difficulty.hard'), href: `${baseUrl}/difficulty/hard`, dot: "bg-rose-500" },
];
---

<div class="flex flex-wrap gap-2 mb-8">
    {
        filters.map((filter) => {
            const active = currentFilter === filter.key;
            return (
                <a
                    href={filter.href}
                    aria-current={active ? "page" : undefined}
                    class={`group inline-flex items-center gap-2 px-4 py-1.5 rounded-[4px] text-sm font-mono transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 ${
                        active
                            ? "bg-ink text-canvas"
                            : "border border-hairline text-mute hover:text-ink hover:bg-canvas-soft"
                    }`}
                >
                    {filter.dot && (
                        <span class={`h-1.5 w-1.5 rounded-full ${filter.dot}`} />
                    )}
                    {filter.label}
                </a>
            );
        })
    }
</div>
