---
import { useTranslations } from "../i18n/ui";

interface Props {
    currentFilter?: "All" | "Easy" | "Medium" | "Hard";
    baseUrl?: string;
}

const { currentFilter = "All", baseUrl = "/leetcode" } = Astro.props;
const lang = (Astro.currentLocale as keyof typeof import('../i18n/ui').ui) || 'en';
const t = useTranslations(lang);

const filters = [
    {
        key: "All",
        label: t('leetcode.filter_all'),
        href: `${baseUrl}`,
        color: "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700",
    },
    {
        key: "Easy",
        label: t('difficulty.easy'),
        href: `${baseUrl}/difficulty/easy`,
        color: "bg-emerald-50 text-emerald-600 hover:bg-emerald-100 dark:bg-emerald-950 dark:text-emerald-400 dark:hover:bg-emerald-900",
    },
    {
        key: "Medium",
        label: t('difficulty.medium'),
        href: `${baseUrl}/difficulty/medium`,
        color: "bg-amber-50 text-amber-600 hover:bg-amber-100 dark:bg-amber-950 dark:text-amber-400 dark:hover:bg-amber-900",
    },
    {
        key: "Hard",
        label: t('difficulty.hard'),
        href: `${baseUrl}/difficulty/hard`,
        color: "bg-rose-50 text-rose-600 hover:bg-rose-100 dark:bg-rose-950 dark:text-rose-400 dark:hover:bg-rose-900",
    },
];

const activeClasses = "ring-2 ring-offset-2 ring-brand-500 font-bold dark:ring-offset-slate-950";
---

<div class="flex flex-wrap gap-4 mb-8">
    {
        filters.map((filter) => (
            <a
                href={filter.href}
                aria-current={currentFilter === filter.key ? "page" : undefined}
                class={`px-4 py-2 rounded-full text-sm transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 ${filter.color} ${currentFilter === filter.key ? activeClasses : ""}`}
            >
                {filter.label}
            </a>
        ))
    }
</div>
