---
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: 'en' | 'es';
}

interface LanguageStats {
  name: string;
  percent: number;
  color: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const USERNAME = "eddndev";
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;

let languages: LanguageStats[] = [];

// The language bar is a data visualization -> it carries the violet "machine"
// scale (like the heatmap). A single coherent violet ramp, no cold slate.
const dataPalette = [
    "#5137a6",
    "#6548c8",
    "#7458d8",
    "#9479ee",
    "#b7a3fb",
    "#d3c6ff",
    "#e8e1ff",
];

if (GITHUB_TOKEN) {
  try {
    const ORGS = ["achronyme", "eddndev-studio", "eddndev-archive"];

    const orgQueries = ORGS.map((org, i) => `
      org${i}: organization(login: "${org}") {
        repositories(first: 100) {
          nodes {
            languages(first: 10, orderBy: {field: SIZE, direction: DESC}) {
              edges {
                size
                node { name }
              }
            }
          }
        }
      }
    `).join("\n");

    const query = `
      query {
        user(login: "${USERNAME}") {
          repositories(ownerAffiliations: OWNER, first: 100) {
            nodes {
              languages(first: 10, orderBy: {field: SIZE, direction: DESC}) {
                edges {
                  size
                  node { name }
                }
              }
            }
          }
        }
        ${orgQueries}
      }
    `;

    const response = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${GITHUB_TOKEN}`,
        "Content-Type": "application/json",
        "User-Agent": "Astro-Build"
      },
      body: JSON.stringify({ query })
    });

    const json = await response.json();

    if (json.data) {
      const allRepos: any[] = [];

      // User's own repos
      if (json.data.user?.repositories?.nodes) {
        allRepos.push(...json.data.user.repositories.nodes);
      }

      // Organization repos
      ORGS.forEach((_org, i) => {
        const orgData = json.data[`org${i}`];
        if (orgData?.repositories?.nodes) {
          allRepos.push(...orgData.repositories.nodes);
        }
      });

      const langMap: Record<string, number> = {};

      allRepos.forEach((repo: any) => {
        repo.languages?.edges?.forEach((edge: any) => {
          const { name } = edge.node;
          langMap[name] = (langMap[name] || 0) + edge.size;
        });
      });

      const totalSize = Object.values(langMap).reduce((a, b) => a + b, 0);
      languages = Object.entries(langMap)
        .map(([name, size]) => ({
          name,
          percent: parseFloat(((size / totalSize) * 100).toFixed(1)),
          color: ''
        }))
        .filter(l => !['HTML', 'CSS'].includes(l.name))
        .sort((a, b) => b.percent - a.percent)
        .slice(0, 7)
        .map((l, i) => ({ ...l, color: dataPalette[i % dataPalette.length] }));
    }
  } catch (e) {
    console.warn("GitHub GraphQL Fetch failed", e);
  }
}

const totalPercent = languages.reduce((acc, curr) => acc + curr.percent, 0);
---

<section class="w-full border-t border-hairline py-12">
  <div class="mb-7 flex items-center justify-between">
    <div class="flex items-baseline gap-4">
      <h3 class="text-2xl font-semibold tracking-[-0.04em] text-ink">
        {t('languages.most_used')}
      </h3>
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-mute">
        {t('languages.stats_label')}
      </span>
    </div>
  </div>

  {languages.length > 0 ? (
    <div class="grid gap-10 md:grid-cols-12 md:gap-6">
      <div class="border-t border-hairline pt-6 md:col-span-8">
        <div class="flex h-2 w-full overflow-hidden bg-hairline">
          {languages.map((language) => (
            <div
              style={{ width: `${(language.percent / totalPercent) * 100}%`, backgroundColor: language.color }}
              class="group relative h-full transition-opacity duration-500 hover:opacity-80"
            >
              <div class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden -translate-x-1/2 whitespace-nowrap bg-[#1c1916] px-2 py-1 font-mono text-xs text-[#f7f5f0] group-hover:block">
                {language.name} {language.percent}%
                <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-[#1c1916]"></div>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-5 max-w-[44ch] text-sm leading-relaxed text-body">
          {t('languages.description')}
        </p>
      </div>

      <div class="border-t border-hairline md:col-span-4">
        {languages.map((language) => (
          <div class="grid grid-cols-[1fr_auto] items-center border-b border-hairline py-2.5">
            <div class="flex items-center gap-2">
              <div
                class="h-0.5 w-3"
                style={{ backgroundColor: language.color }}
              ></div>
              <span class="text-xs font-medium text-body-strong">{language.name}</span>
            </div>
            <span class="font-mono text-[10px] text-mute">{language.percent}%</span>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <p class="border-y border-hairline py-6 text-sm text-body">
      {t('languages.unavailable')}
    </p>
  )}
</section>
