---
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: 'en' | 'es';
}

interface ContributionDay {
  date: string;
  count: number;
  level: 0 | 1 | 2 | 3 | 4;
  isFuture: boolean;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const USERNAME = "eddndev";
let totalSubmissions = 0;
let weeks: ContributionDay[][] = [];

// New stats
let hardSolved = 0;
let mediumSolved = 0;
let easySolved = 0;
let acceptanceRate = 0;

const getLevel = (count: number): 0 | 1 | 2 | 3 | 4 => {
  if (count === 0) return 0;
  if (count === 1) return 1;
  if (count === 2) return 2;
  if (count <= 4) return 3;
  return 4;
};

// 1. FETCH DATA (Server Side) - Direct LeetCode GraphQL API
try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 seconds timeout

  const query = `
    query getUserProfile($username: String!) {
      matchedUser(username: $username) {
        profile { ranking }
        submitStatsGlobal {
          acSubmissionNum { difficulty count submissions }
        }
        submissionCalendar
      }
    }
  `;

  const response = await fetch('https://leetcode.com/graphql', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Referer': 'https://leetcode.com',
    },
    body: JSON.stringify({ query, variables: { username: USERNAME } }),
    signal: controller.signal,
  });

  clearTimeout(timeoutId);

  if (response.ok) {
    const json = await response.json();
    const user = json.data?.matchedUser;
    if (user) {
       // Extract stats from GraphQL response
       const stats = user.submitStatsGlobal?.acSubmissionNum ?? [];
       let totalAccepted = 0;
       let totalAttempts = 0;
       for (const s of stats) {
         if (s.difficulty === 'Easy') easySolved = s.count;
         else if (s.difficulty === 'Medium') mediumSolved = s.count;
         else if (s.difficulty === 'Hard') hardSolved = s.count;
         if (s.difficulty === 'All') {
           totalAccepted = s.count;
           totalAttempts = s.submissions;
         }
       }
       acceptanceRate = totalAttempts > 0
         ? Math.round((totalAccepted / totalAttempts) * 10000) / 100
         : 0;

       const rawCalendarData = user.submissionCalendar;
       if (rawCalendarData) {
          const rawCalendar = typeof rawCalendarData === 'string'
            ? JSON.parse(rawCalendarData)
            : rawCalendarData;

          const normalizedMap = new Map<string, number>();
          const now = new Date();
          now.setHours(0, 0, 0, 0);

          Object.entries(rawCalendar).forEach(([ts, count]) => {
             // LeetCode returns timestamps in seconds.
             // We filter out any submission that claims to be in the future relative to server time.
             const date = new Date(parseInt(ts) * 1000);
             date.setHours(0, 0, 0, 0);

             if (date > now) return;

             const dateStr = date.toISOString().split('T')[0];
             normalizedMap.set(dateStr, (normalizedMap.get(dateStr) || 0) + (count as number));
          });

          const end = new Date(now);
          // Calculate start: Go back ~1 year (52 weeks)
          const start = new Date(end);
          start.setDate(start.getDate() - 365);

          // ALIGN TO SUNDAY: Go back to the previous Sunday (or stay if today is Sunday)
          // getDay(): 0 = Sunday, 1 = Monday, ...
          start.setDate(start.getDate() - start.getDay());

          let current = new Date(start);
          // Reset hours to avoid DST issues affecting day loop
          current.setHours(0, 0, 0, 0);

          let week: ContributionDay[] = [];
          let yearTotal = 0;

          // Loop until we pass 'end' or finish the last week
          while (current <= end || week.length > 0) {
            const dateStr = current.toISOString().split('T')[0];
            // Only count submissions if current date is within valid range (<= end)
            // But we might need to pad the rest of the week with empty cells if we passed 'end'

            const isFuture = current > end;
            const count = !isFuture ? (normalizedMap.get(dateStr) || 0) : 0;

            if (!isFuture) {
                 yearTotal += count;
            }

            week.push({
                date: current.toISOString(),
                count: count,
                level: getLevel(count),
                isFuture
            });

            if (week.length === 7) {
                weeks.push(week);
                week = [];
            }

            // Safety break if we went too far past end and finished the week
            if (current > end && week.length === 0) break;

            current.setDate(current.getDate() + 1);
          }
          totalSubmissions = yearTotal;
       }
    }
  }
} catch (e) {
  console.warn("LeetCode GraphQL fetch failed:", e instanceof Error ? e.message : e);
}

// Heatmap is the sanctioned place for the violet "machine" scale (it is data).
// Empty cells use the warm neutral surface.
const getServerColor = (level: number) => {
  switch (level) {
    case 1: return 'bg-brand-300 dark:bg-brand-900';
    case 2: return 'bg-brand-500 dark:bg-brand-700';
    case 3: return 'bg-brand-700 dark:bg-brand-500';
    case 4: return 'bg-brand-900 dark:bg-brand-300';
    default: return 'bg-canvas-soft';
  }
};
---

<section class="w-full border-t border-hairline py-14 sm:py-16">
  <div class="mb-10 flex items-center justify-between">
    <div class="flex items-baseline gap-4">
      <h3 class="text-2xl font-semibold tracking-[-0.04em] text-ink sm:text-3xl">
        {t('leetcode.activity')}
      </h3>
      <a href={`https://leetcode.com/u/${USERNAME}`} target="_blank" rel="noopener noreferrer" class="rounded-sm font-mono text-[10px] uppercase tracking-[0.14em] text-mute transition-colors duration-500 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
        @{USERNAME}
      </a>
    </div>

    <div id="lc-total" class="hidden font-mono text-[10px] uppercase tracking-[0.12em] text-mute transition-opacity duration-500 sm:block">
      {weeks.length > 0
        ? `${totalSubmissions} ${t('github.submissions_last_year')}`
        : '...'}
    </div>
  </div>

  <!-- Compact metrics row -->
  {weeks.length > 0 ? (
    <div data-proof-row class="mb-12 grid grid-cols-2 border-b border-t border-hairline sm:grid-cols-5">
      <div class="col-span-2 py-5 sm:col-span-1 sm:pr-5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-mute">{t('leetcode.contest_rating')}</span>
        <strong class="mt-2 block font-mono text-3xl font-normal tracking-[-0.05em] text-ink">2,887</strong>
        <span class="mt-1 block text-xs text-body">Guardian / top 0.02%</span>
      </div>
      <div class="border-l border-hairline px-4 py-5 sm:px-5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">{t('difficulty.easy')}</span>
        <strong class="mt-2 block font-mono text-2xl font-normal text-ink">{easySolved}</strong>
      </div>
      <div class="border-l border-hairline px-4 py-5 sm:px-5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-amber-700 dark:text-amber-300">{t('difficulty.medium')}</span>
        <strong class="mt-2 block font-mono text-2xl font-normal text-ink">{mediumSolved}</strong>
      </div>
      <div class="border-l border-t border-hairline px-4 py-5 sm:border-t-0 sm:px-5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-rose-700 dark:text-rose-300">{t('difficulty.hard')}</span>
        <strong class="mt-2 block font-mono text-2xl font-normal text-ink">{hardSolved}</strong>
      </div>
      <div class="border-l border-t border-hairline px-4 py-5 sm:border-t-0 sm:px-5">
        <span class="block font-mono text-[11px] uppercase tracking-[0.16em] text-mute">{t('leetcode.acceptance_rate')}</span>
        <strong class="mt-2 block font-mono text-2xl font-normal text-ink">{acceptanceRate}%</strong>
      </div>
    </div>
  ) : (
      <div class="mb-8 h-32 w-full animate-pulse border-y border-hairline bg-canvas-soft"></div>
  )}

  <div class="w-full overflow-x-auto pb-2 custom-scrollbar">
      <div
        id="lc-grid"
        class="inline-flex gap-[3px] min-w-full justify-end sm:justify-start p-1"
        data-i18n-contributions={lang === 'es' ? 'contribuciones' : 'contributions'}
        data-i18n-on={lang === 'es' ? 'el' : 'on'}
      >
          {weeks.length > 0 ? (
            weeks.map((week) => (
                <div class="flex flex-col gap-[3px]">
                    {week.map((day) => (
                        day.isFuture ? (
                           <div class="h-3 w-3 rounded-[1px] opacity-0"></div>
                        ) : (
                          <div
                              class={`lc-cell h-3 w-3 rounded-[1px] ${getServerColor(day.level)} transition-colors duration-200 hover:ring-2 hover:ring-brand-500/50 hover:z-10`}
                              data-count={day.count}
                              data-date={new Date(day.date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { dateStyle: 'long' })}
                          ></div>
                        )
                    ))}
                </div>
            ))
          ) : (
             Array.from({ length: 53 }).map(() => (
              <div class="flex flex-col gap-[3px]">
                  {Array.from({ length: 7 }).map(() => (
                      <div class="h-3 w-3 animate-pulse rounded-[1px] bg-canvas-soft"></div>
                  ))}
              </div>
            ))
          )}
      </div>
  </div>

  <div class="flex items-center gap-2 text-xs text-mute mt-4 justify-start font-mono">
      <span>{t('github.less')}</span>
      <div class="h-3 w-3 rounded-[1px] bg-canvas-soft"></div>
      <div class="h-3 w-3 rounded-[1px] bg-brand-300 dark:bg-brand-900"></div>
      <div class="h-3 w-3 rounded-[1px] bg-brand-500 dark:bg-brand-700"></div>
      <div class="h-3 w-3 rounded-[1px] bg-brand-700 dark:bg-brand-500"></div>
      <div class="h-3 w-3 rounded-[1px] bg-brand-900 dark:bg-brand-300"></div>
      <span>{t('github.more')}</span>
  </div>
</section>

<script>
    function initLeetCodeContributions() {
        const grid = document.getElementById('lc-grid');
        const scrollContainer = grid?.parentElement;

        function scrollToEnd() {
            if (scrollContainer) {
                requestAnimationFrame(() => {
                    setTimeout(() => {
                        scrollContainer.scrollLeft = scrollContainer.scrollWidth;
                    }, 0);
                });
            }
        }

        let tooltip = document.getElementById('gh-tooltip');
        let tooltipContent: HTMLElement | null = null;

        if (!tooltip) {
            tooltip = document.createElement('div');
            tooltip.id = 'gh-tooltip';
            tooltip.className = 'fixed z-[70] pointer-events-none opacity-0 invisible bg-[#15111e] text-[#f8f5ff] px-3 py-1.5 rounded-full text-xs font-mono shadow-xl transition-[opacity,transform] duration-200 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] transform translate-x-[-50%] translate-y-[-100%]';
            tooltipContent = document.createElement('div');
            tooltip.appendChild(tooltipContent);
            const arrow = document.createElement('div');
            arrow.className = 'absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-full w-0 h-0 border-l-[4px] border-l-transparent border-r-[4px] border-r-transparent border-t-[4px] border-t-[#1c1916]';
            tooltip.appendChild(arrow);
            document.body.appendChild(tooltip);
        } else {
            tooltipContent = tooltip.firstElementChild as HTMLElement;
        }

        if (grid && tooltip && tooltipContent) {
            const i18nContributions = grid.getAttribute('data-i18n-contributions') || 'contributions';
            const i18nOn = grid.getAttribute('data-i18n-on') || 'on';

            const onMouseEnter = (e: MouseEvent) => {
                const target = e.target as HTMLElement;
                if (target.classList.contains('lc-cell')) {
                    const count = target.getAttribute('data-count');
                    const date = target.getAttribute('data-date');
                    if (count && date && tooltipContent) {
                        tooltipContent.innerHTML = `<strong>${count}</strong> ${i18nContributions} <span class="text-white/50">${i18nOn} ${date}</span>`;
                        tooltip!.style.visibility = 'visible';
                        tooltip!.style.opacity = '1';
                        tooltip!.classList.add('translate-y-[-100%]');
                        tooltip!.classList.remove('translate-y-[-90%]');
                        updatePosition(e);
                    }
                }
            };

            const updatePosition = (e: MouseEvent) => {
                const x = e.clientX;
                const y = e.clientY - 12;
                tooltip!.style.left = `${x}px`;
                tooltip!.style.top = `${y}px`;
            };

            const onMouseLeave = (e: MouseEvent) => {
                const target = e.target as HTMLElement;
                if (target.classList.contains('lc-cell')) {
                    tooltip!.style.opacity = '0';
                    tooltip!.style.visibility = 'hidden';
                }
            };

            grid.addEventListener('mouseover', onMouseEnter);
            grid.addEventListener('mousemove', updatePosition);
            grid.addEventListener('mouseout', onMouseLeave);
        }

        // Initial scroll to end
        scrollToEnd();
    }
    document.addEventListener('astro:page-load', initLeetCodeContributions);
</script>
